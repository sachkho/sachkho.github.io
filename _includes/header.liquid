{% if page.permalink != '/' %}
  <header class="site-header">
    <div class="container site-header-inner">
      <a class="site-header-brand" href="{{ '/' | relative_url }}">
        {% if site.title == 'blank' %}
          {{ site.first_name }}
          {{ site.middle_name }}
          {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </a>

      <div class="site-header-icons">{% social_links %}</div>

      {% include pill_nav.liquid %}
    </div>
  </header>
{% endif %}
